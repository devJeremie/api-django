# Utilisé de deux façons : directement par docker-compose (env_file:) pour
# les variables d'initialisation propres à l'image mysql:8 (MYSQL_*), et par
# Django via os.environ.get(...) dans api/settings.py (DB_*) pour sa config DATABASES.

# --- Lu par api/settings.py (DATABASES) ---
DB_NAME=api-rest-django
DB_USER=root
DB_PASSWORD=
# "db" = le nom du service docker-compose, résolu via le DNS interne de Docker.
# Pas 127.0.0.1 — depuis l'intérieur du conteneur `web`, cela désignerait le
# conteneur lui-même, pas le service `db`.
DB_HOST=db
# Port interne sur le réseau Docker — sans rapport avec le mapping du port
# hôte 3307 dans docker-compose.yml.
DB_PORT=3306

# --- Lu par l'entrypoint de l'image mysql:8 (initialisation du conteneur uniquement) ---
MYSQL_DATABASE=api-rest-django
# Pas de mot de passe root, pour la commodité du dev local. MYSQL_ROOT_HOST=%
# est requis en complément : sans cela, `root` n'est autorisé à se connecter
# que depuis localhost, et le conteneur `web` (un autre hôte sur le réseau
# Docker) reçoit "Host '...' is not allowed to connect". Les deux variables
# ne prennent effet qu'à la PREMIÈRE initialisation du volume mysql_data —
# les modifier plus tard nécessite `docker-compose down -v` pour réinitialiser
# le volume avant qu'elles s'appliquent.
MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_ROOT_HOST=%
