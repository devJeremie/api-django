# Consumed two ways: directly by docker-compose (env_file:) for the mysql:8
# image's own init vars (MYSQL_*), and by Django via os.environ.get(...) in
# api/settings.py (DB_*) for its DATABASES config.

# --- Read by api/settings.py (DATABASES) ---
DB_NAME=api-rest-django
DB_USER=root
DB_PASSWORD=
# "db" = the docker-compose service name, resolved via Docker's internal DNS.
# Not 127.0.0.1 — from inside the `web` container, that would mean the
# container itself, not the `db` service.
DB_HOST=db
# Internal port on the Docker network — unrelated to the 3307 host mapping
# in docker-compose.yml.
DB_PORT=3306

# --- Read by the mysql:8 image's entrypoint (container init only) ---
MYSQL_DATABASE=api-rest-django
# No root password for local dev convenience. MYSQL_ROOT_HOST=% is required
# alongside this: without it, `root` is only permitted to connect from
# localhost, and the `web` container (a different host on the Docker
# network) gets "Host '...' is not allowed to connect". Both vars only take
# effect on the FIRST init of the mysql_data volume — changing them later
# needs `docker-compose down -v` to reset the volume before they apply.
MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_ROOT_HOST=%
